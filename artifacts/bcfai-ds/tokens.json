{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Blue Collar Financial AI design tokens (DTCG format). Single source of truth — edit here only. Navy + emerald palette for a trust-first financial product built for trade workers. Colors are hex; the generator converts them to H S% L% channels for the shadcn theme (web) and keeps hex for mobile.",
  "color": {
    "$type": "color",
    "light": {
      "background":              { "$value": "#f6f7f9", "$description": "Page background — near-white with a blue-gray tint." },
      "foreground":              { "$value": "#1f2733", "$description": "Default body text — deep navy." },
      "border":                  { "$value": "#dae0e7" },
      "card":                    { "$value": "#ffffff" },
      "cardForeground":          { "$value": "#1f2733" },
      "popover":                 { "$value": "#ffffff" },
      "popoverForeground":       { "$value": "#1f2733" },
      "primary": {
        "$value": "#2c9664",
        "$description": "Emerald green — buttons, CTAs, primary emphasis. Core brand color."
      },
      "primaryForeground":       { "$value": "#ffffff" },
      "secondary": {
        "$value": "#213550",
        "$description": "Deep navy — secondary surfaces, sidebar, structural elements."
      },
      "secondaryForeground":     { "$value": "#ffffff" },
      "muted":                   { "$value": "#eaedf1" },
      "mutedForeground":         { "$value": "#647287" },
      "accent": {
        "$value": "#e9f7f0",
        "$description": "Very light green — accent surfaces, highlights, success indicators."
      },
      "accentForeground":        { "$value": "#206f4a" },
      "destructive":             { "$value": "#d92d20" },
      "destructiveForeground":   { "$value": "#ffffff" },
      "input":                   { "$value": "#dae0e7" },
      "ring":                    { "$value": "#2c9664" },
      "chart1":                  { "$value": "#2c9664", "$description": "Green — primary series (income, positive)." },
      "chart2":                  { "$value": "#2c486d", "$description": "Navy blue — secondary series (expenses, totals)." },
      "chart3":                  { "$value": "#ee9d2b", "$description": "Amber — tertiary series (warnings, changes)." },
      "chart4":                  { "$value": "#d92d20", "$description": "Red — negative series (deficits, alerts)." },
      "chart5":                  { "$value": "#2e93b8", "$description": "Teal — fifth series (savings, projections)." },
      "sidebar":                 { "$value": "#213550", "$description": "Navy sidebar surface." },
      "sidebarForeground":       { "$value": "#dee6ed" },
      "sidebarBorder":           { "$value": "#294365" },
      "sidebarPrimary":          { "$value": "#2c9664" },
      "sidebarPrimaryForeground":{ "$value": "#ffffff" },
      "sidebarAccent":           { "$value": "#294365" },
      "sidebarAccentForeground": { "$value": "#eef2f6" },
      "sidebarRing":             { "$value": "#2c9664" }
    },
    "dark": {
      "background":              { "$value": "#0f1824", "$description": "Dark navy page background." },
      "foreground":              { "$value": "#eef2f6" },
      "border":                  { "$value": "#243142" },
      "card":                    { "$value": "#131f2f" },
      "cardForeground":          { "$value": "#eef2f6" },
      "popover":                 { "$value": "#131f2f" },
      "popoverForeground":       { "$value": "#eef2f6" },
      "primary":                 { "$value": "#39ac77" },
      "primaryForeground":       { "$value": "#0f1824" },
      "secondary":               { "$value": "#213550" },
      "secondaryForeground":     { "$value": "#eef2f6" },
      "muted":                   { "$value": "#1c293b" },
      "mutedForeground":         { "$value": "#7589a3" },
      "accent":                  { "$value": "#203c2f" },
      "accentForeground":        { "$value": "#79d2a9" },
      "destructive":             { "$value": "#df453a" },
      "destructiveForeground":   { "$value": "#ffffff" },
      "input":                   { "$value": "#273649" },
      "ring":                    { "$value": "#39ac77" },
      "chart1":                  { "$value": "#39ac77" },
      "chart2":                  { "$value": "#6692cc" },
      "chart3":                  { "$value": "#eba747" },
      "chart4":                  { "$value": "#df453a" },
      "chart5":                  { "$value": "#47acd1" },
      "sidebar":                 { "$value": "#0b131e" },
      "sidebarForeground":       { "$value": "#cdd9e4" },
      "sidebarBorder":           { "$value": "#1b2737" },
      "sidebarPrimary":          { "$value": "#39ac77" },
      "sidebarPrimaryForeground":{ "$value": "#0f1824" },
      "sidebarAccent":           { "$value": "#18273a" },
      "sidebarAccentForeground": { "$value": "#dee6ed" },
      "sidebarRing":             { "$value": "#39ac77" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans":  { "$value": ["Inter", "sans-serif"],  "$description": "Primary UI and body typeface. Variable weight 400–700." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono":  { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius — slightly rounded; sm/md/lg/xl derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step the shadcn components multiply."
    }
  }
}
